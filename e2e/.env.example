# Copy to .env and source before running E2E against a real cluster.
# For local docker-compose, leave everything unset — anonymous auth works.

# Where Grafana lives
GRAFANA_URL=http://localhost:3000

# Authentication — pick ONE:
# 1. Service account token (recommended for CI / cluster)
# GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Basic auth
# GRAFANA_USER=admin
# GRAFANA_PASS=changeme

# Alloy live UI (for component-graph assertions)
ALLOY_URL=http://localhost:12345

# Don't auto-bring-up the compose stack (you already have one running)
# SKIP_WEBSERVER=1
