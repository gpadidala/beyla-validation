{
  "uid": "beyla-health",
  "title": "Beyla • Health",
  "tags": ["beyla", "ebpf", "platform"],
  "schemaVersion": 41,
  "version": 2,
  "timezone": "",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" } },
      { "name": "cluster", "type": "query", "datasource": "${datasource}",
        "query": "label_values(beyla_internal_build_info, cluster)",
        "refresh": 2, "includeAll": true, "multi": true },
      { "name": "instance", "type": "query", "datasource": "${datasource}",
        "query": "label_values(beyla_internal_build_info{cluster=~\"$cluster\"}, instance)",
        "refresh": 2, "includeAll": true, "multi": true }
    ]
  },
  "panels": [
    { "id": 1, "type": "stat", "title": "Beyla pods (or Alloy-with-Beyla)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "count(beyla_internal_build_info{cluster=~\"$cluster\"})", "refId": "A" }] },

    { "id": 2, "type": "stat", "title": "Processes instrumented (cluster total)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(beyla_instrumented_processes{cluster=~\"$cluster\"})", "refId": "A" }] },

    { "id": 3, "type": "stat", "title": "Instrumentation errors (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(increase(beyla_instrumentation_errors_total{cluster=~\"$cluster\"}[1h]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 }] } } } },

    { "id": 4, "type": "stat", "title": "Export errors / sec (metrics + traces)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(rate(beyla_otel_metric_export_errors_total{cluster=~\"$cluster\"}[5m])) + sum(rate(beyla_otel_trace_export_errors_total{cluster=~\"$cluster\"}[5m]))", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 0.1 }] } } } },

    { "id": 10, "type": "timeseries", "title": "Instrumented processes — per pod",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "sum by (instance) (beyla_instrumented_processes{cluster=~\"$cluster\",instance=~\"$instance\"})", "refId": "A", "legendFormat": "{{instance}}" }] },

    { "id": 11, "type": "timeseries", "title": "OTel export throughput",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum(rate(beyla_otel_metric_exports_total{cluster=~\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "metric exports/s" },
        { "expr": "sum(rate(beyla_otel_trace_exports_total{cluster=~\"$cluster\"}[5m]))",  "refId": "B", "legendFormat": "trace exports/s" }
      ] },

    { "id": 12, "type": "timeseries", "title": "Export errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(beyla_otel_metric_export_errors_total{cluster=~\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "metrics" },
        { "expr": "sum(rate(beyla_otel_trace_export_errors_total{cluster=~\"$cluster\"}[5m]))",  "refId": "B", "legendFormat": "traces"  }
      ] },

    { "id": 13, "type": "timeseries", "title": "eBPF ringbuf flush P95 (sec)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(beyla_ebpf_tracer_flushes_bucket{cluster=~\"$cluster\"}[5m])))", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" } } },

    { "id": 14, "type": "timeseries", "title": "Beyla CPU per pod",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [{ "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{pod=~\"beyla-.*|alloy-.*\",cluster=~\"$cluster\"}[5m]))", "refId": "A", "legendFormat": "{{pod}}" }] },

    { "id": 15, "type": "timeseries", "title": "Beyla memory working set",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [{ "expr": "sum by (pod) (container_memory_working_set_bytes{pod=~\"beyla-.*|alloy-.*\",cluster=~\"$cluster\"})", "refId": "A", "legendFormat": "{{pod}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } } },

    { "id": 16, "type": "stat", "title": "Beyla version distribution",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [{ "expr": "count by (revision) (beyla_internal_build_info{cluster=~\"$cluster\"})", "refId": "A", "legendFormat": "{{revision}}" }] }
  ]
}
