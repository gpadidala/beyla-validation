# Application-layer queries.
# All queries assume Beyla labels: service_name, k8s_namespace_name,
# http_route, http_response_status_code, cluster.

# ── Latency (P50 / P95 / P99) ────────────────────────────────────────────
app_latency_p50 = histogram_quantile(0.50,
  sum by (le, service_name, k8s_namespace_name)
    (rate(http_server_request_duration_seconds_bucket[5m])))

app_latency_p95 = histogram_quantile(0.95,
  sum by (le, service_name, k8s_namespace_name)
    (rate(http_server_request_duration_seconds_bucket[5m])))

app_latency_p99 = histogram_quantile(0.99,
  sum by (le, service_name, k8s_namespace_name)
    (rate(http_server_request_duration_seconds_bucket[5m])))

# ── Throughput (RPS) ─────────────────────────────────────────────────────
app_rps = sum by (service_name, k8s_namespace_name)
    (rate(http_server_request_duration_seconds_count[5m]))

# ── Error rate (5xx as % of total) ───────────────────────────────────────
app_error_rate = sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~"5.."}[5m]))
                 /
                 sum by (service_name) (rate(http_server_request_duration_seconds_count[5m]))

# ── Latency Δ vs recorded baseline ───────────────────────────────────────
# Requires a recording rule app:latency_p99_baseline:5m{service_name=…}
app_latency_p99_delta_pct =
  ( histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[5m])))
    - on (service_name) app:latency_p99_baseline:5m )
    / on (service_name) app:latency_p99_baseline:5m * 100

# ── RED golden signals ───────────────────────────────────────────────────
app_red_rate     = sum by (service_name) (rate(http_server_request_duration_seconds_count[1m]))
app_red_errors   = sum by (service_name) (rate(http_server_request_duration_seconds_count{http_response_status_code=~"5.."}[1m]))
app_red_duration = histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_request_duration_seconds_bucket[1m])))

# ── Endpoint-level hot path (top 10 slowest routes) ──────────────────────
hot_routes = topk(10, histogram_quantile(0.99,
  sum by (le, service_name, http_route)
    (rate(http_server_request_duration_seconds_bucket[5m]))))
