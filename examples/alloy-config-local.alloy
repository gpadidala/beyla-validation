// Local-dev Alloy config. Talks to docker-compose hostnames.
//
// IMPORTANT: when Beyla runs as an Alloy component, it publishes its
// metrics (BOTH self-metrics like beyla_instrumented_processes AND
// application metrics like http_server_request_duration_seconds) via a
// Prometheus scrape endpoint that beyla.ebpf exports as `targets`.
// You MUST wire a `prometheus.scrape` to that target export — the OTel
// `output` block on beyla.ebpf only carries traces, not metrics.

logging {
  level  = "info"
  format = "logfmt"
}

livedebugging {
  enabled = true
}

beyla.ebpf "default" {
  open_port = "80"

  discovery {
    services {
      exe_path = ".*"
    }
  }

  routes {
    unmatched        = "heuristic"
    ignored_patterns = ["/metrics", "/healthz"]
  }

  metrics {
    features = ["application", "application_span", "application_service_graph"]
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// THIS is what gets Beyla's metrics into Prometheus. Without it,
// dashboards show "No data" even though Beyla is capturing traffic.
prometheus.scrape "beyla" {
  targets         = beyla.ebpf.default.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  job_name        = "beyla"
  scrape_interval = "10s"
}

otelcol.processor.batch "default" {
  timeout = "2s"

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
  external_labels = {
    cluster = "local-dev",
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

pyroscope.ebpf "default" {
  forward_to       = [pyroscope.write.default.receiver]
  collect_interval = "10s"
  sample_rate      = 19
}

pyroscope.write "default" {
  endpoint {
    url = "http://pyroscope:4040"
  }
}
